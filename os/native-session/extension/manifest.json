{
  "manifest_version": 3,
  "name": "kidOS native applications",
  "version": "1.2.0",
  "description": "Open this computer's approved native applications from the local kidOS desktop.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.mjs", "type": "module" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false, "match_about_blank": false, "match_origin_as_fallback": false }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
