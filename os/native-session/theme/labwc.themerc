# Original kidOS window chrome. labwc 0.8 compatible keys.
border.width: 2
window.active.border.color: #77877e
window.inactive.border.color: #77877e
window.titlebar.padding.width: 4
window.titlebar.padding.height: 5
window.active.title.bg.color: #233c65
window.inactive.title.bg.color: #d8d8cd
window.active.label.text.color: #fffef5
window.inactive.label.text.color: #53625d
window.label.text.justify: left
window.button.width: 30
window.button.spacing: 3
window.active.button.unpressed.image.color: #fffef5
window.inactive.button.unpressed.image.color: #202e2d
window.button.hover.bg.color: #23776f
menu.border.width: 2
menu.border.color: #77877e
menu.items.bg.color: #fffef5
menu.items.text.color: #202e2d
menu.items.active.bg.color: #233c65
menu.items.active.text.color: #fffef5
menu.items.padding.x: 10
menu.items.padding.y: 7
menu.separator.color: #77877e
menu.title.bg.color: #233c65
menu.title.text.color: #fffef5
osd.bg.color: #f3edcf
osd.border.color: #77877e
osd.border.width: 2
