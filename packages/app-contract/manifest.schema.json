{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kidos:app-manifest:1",
  "title": "kidOS app manifest version 1",
  "description": "An immutable locally installed HTML/CSS/JavaScript app with no granted capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "entryPoint", "runtime", "permissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^project-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d{0,7})\\.(0|[1-9]\\d{0,7})\\.(0|[1-9]\\d{0,7})$" },
    "entryPoint": { "const": "index.html" },
    "runtime": { "const": "web" },
    "permissions": { "type": "array", "maxItems": 0 }
  }
}
